# Accountability Atlas — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Last updated: 2026-08-04 — M7-03 Security Hardening

# --- Supabase ---
# Found in Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://<your-project>.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service role key — SERVER-SIDE ONLY, never expose to browser
# Found in Supabase Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase project reference (for CLI and migrations)
SUPABASE_PROJECT_REF=<your-project-ref>

# --- Database ---
# Connection string for direct DB access (migrations, admin scripts)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Auth ---
# Session duration in seconds (default: 3600 = 1 hour)
SESSION_DURATION_SECONDS=3600

# Refresh token rotation window in seconds
REFRESH_TOKEN_WINDOW_SECONDS=300

# 2FA issuer name (displayed in authenticator apps)
TWO_FACTOR_ISSUER=Accountability Atlas

# --- Rate Limiting ---
# Public endpoints: requests per minute per IP
RATE_LIMIT_PUBLIC_RPM=100
# Admin endpoints: requests per minute per IP
RATE_LIMIT_ADMIN_RPM=30
# Auth endpoints: requests per minute per IP
RATE_LIMIT_AUTH_RPM=10
# Auth endpoints: max failed attempts before lockout
RATE_LIMIT_AUTH_MAX_FAILED=5
# Auth lockout duration in seconds
RATE_LIMIT_AUTH_LOCKOUT_SECONDS=900

# --- Monitoring (optional) ---
# Status page URL
STATUS_PAGE_URL=
# Error tracking DSN (Sentry-compatible)
ERROR_TRACKING_DSN=
# Uptime monitor webhook URL
UPTIME_MONITOR_WEBHOOK_URL=

# --- Deployment ---
# Deployment environment: development | staging | production
DEPLOY_ENV=development

# Base URL for the deployed application (used for canonical URLs, OG tags)
VITE_BASE_URL=http://localhost:5173

# --- Feature Flags ---
# Enable public user registration (default: false for beta)
VITE_ENABLE_PUBLIC_REGISTRATION=false
# Enable anonymous analytics (default: false)
VITE_ENABLE_ANALYTICS=false
# Enable search indexing (default: false for beta)
VITE_ENABLE_INDEXING=false
